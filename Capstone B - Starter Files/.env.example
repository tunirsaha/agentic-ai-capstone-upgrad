# Sahayak Health AI Capstone — environment template
# Copy this file to `.env` and fill in your own key. `.env` is gitignored.
#
#   cp .env.example .env
#
# Gemini / Colab path (get a free key at https://aistudio.google.com/apikey):
GOOGLE_API_KEY=your-gemini-api-key-here

# Local path (no key needed): run Ollama with hermes3:8b pulled —
#   ollama pull hermes3:8b
# The notebooks and eval scripts auto-fall back to Ollama when no Gemini key is set.
